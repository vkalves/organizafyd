# Public frontend configuration. Copy into your deployment settings.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_SUPABASE_KEY
VITE_LEGAL_OPERATOR=
VITE_SUPPORT_EMAIL=
# TikTok secrets belong ONLY in Supabase Edge Functions Secrets.
# See docs/tiktok-publisher.md. Never prefix secrets with VITE_.

# HTTPS URL of the HOTfy background music file (public audio, never a secret).
VITE_BACKGROUND_MUSIC_URL=

# Enable only after the S3 gateway and all backend readers are verified.
VITE_STORAGE_PROVIDER=supabase
