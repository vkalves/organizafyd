# AWS Frontend Configuration (Cognito + API Gateway + RDS PostgreSQL + S3)
VITE_AWS_API_URL=https://YOUR_API_ID.execute-api.us-east-2.amazonaws.com
VITE_AWS_REGION=us-east-2
VITE_AWS_COGNITO_USER_POOL_ID=us-east-2_XXXXXXXXX
VITE_AWS_COGNITO_CLIENT_ID=YOUR_COGNITO_APP_CLIENT_ID
VITE_STORAGE_PROVIDER=aws

VITE_LEGAL_OPERATOR=
VITE_SUPPORT_EMAIL=

# Backend secrets (RDS DATABASE_URL, TikTok/X/Meta/Google OAuth secrets) belong ONLY
# in AWS Secrets Manager / AWS Lambda environment variables. Never prefix secrets with VITE_.
