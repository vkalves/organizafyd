+++ b/src/components/layout/login-transition.css
@@ -0,0 +1,50 @@
+.login-transition {
+  position: fixed;
+  inset: 0;
+  z-index: 200;
+  display: grid;
+  place-items: center;
+  overflow: hidden;
+  background: #0a0a0b;
+  color: #f4f3f0;
+  animation: lt-in .35s ease-out both;
+}
+.login-transition-glow {
+  position: absolute;
+  width: 70vmax;
+  height: 70vmax;
+  border-radius: 50%;
+  background: radial-gradient(closest-side, #dedbd61f, #dedbd600);
+  animation: lt-glow 2.4s ease-in-out both;
+}
+.login-transition-center { position: relative; display: flex; flex-direction: column; align-items: center; text-align: center; padding: 24px; }
+.login-transition-ring { position: relative; display: grid; place-items: center; width: 132px; height: 132px; animation: lt-pop .7s cubic-bezier(.2,.8,.2,1) both; }
+.login-transition-ring svg { position: absolute; inset: 0; width: 100%; height: 100%; transform: rotate(-90deg); }
+.login-transition-ring circle { fill: none; stroke-width: 2; }
+.login-transition-track { stroke: #ffffff14; }
+.login-transition-arc { stroke: #dedbd6; stroke-linecap: round; stroke-dasharray: 100; stroke-dashoffset: 100; filter: drop-shadow(0 0 6px #dedbd680); animation: lt-draw 1.7s .25s cubic-bezier(.5,0,.2,1) forwards; }
+.login-transition-ring .silver-brand img { width: 56px; height: 56px; }
+.login-transition-hello { margin-top: 34px; color: #a7a6a3; font-size: 13px; letter-spacing: 2px; text-transform: uppercase; animation: lt-up .6s .5s ease-out both; }
+.login-transition-name { margin-top: 8px; max-width: 80vw; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: clamp(28px, 5vw, 44px); font-weight: 500; letter-spacing: -1.4px; animation: lt-up .6s .7s ease-out both; }
+.login-transition-sub { margin-top: 14px; color: #8b8b89; font-size: 12px; animation: lt-up .6s .95s ease-out both; }
+.login-transition-bar { position: absolute; left: 0; right: 0; bottom: 0; height: 2px; background: linear-gradient(90deg, transparent, #dedbd6, transparent); transform-origin: left; animation: lt-bar 2.2s ease-in-out both; }
+
+@keyframes lt-in { from { opacity: 0; } to { opacity: 1; } }
+@keyframes lt-pop { from { opacity: 0; transform: scale(.6); } to { opacity: 1; transform: scale(1); } }
+@keyframes lt-draw { to { stroke-dashoffset: 0; } }
+@keyframes lt-up { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: translateY(0); } }
+@keyframes lt-glow { 0% { opacity: 0; transform: scale(.6); } 50% { opacity: 1; } 100% { opacity: .6; transform: scale(1.1); } }
+@keyframes lt-bar { from { transform: scaleX(0); } to { transform: scaleX(1); } }
+
+/* Entrada suave do formulário de login */
+.auth-card > * { animation: lt-up .55s ease-out both; }
+.auth-card > :nth-child(2) { animation-delay: .06s; }
+.auth-card > :nth-child(3) { animation-delay: .12s; }
+.auth-card > :nth-child(4) { animation-delay: .18s; }
+.auth-card > :nth-child(5) { animation-delay: .24s; }
+.auth-story-content { animation: lt-up .7s .1s ease-out both; }
+
+@media (prefers-reduced-motion: reduce) {
+  .login-transition, .login-transition *, .auth-card > *, .auth-story-content { animation-duration: .01ms !important; animation-delay: 0s !important; }
+  .login-transition-arc { stroke-dashoffset: 0; }
+}
