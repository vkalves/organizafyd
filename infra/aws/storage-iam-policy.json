{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::avanca-files-108327566923-us-east-2",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "media/*",
            "instagram-publisher/*",
            "tiktok-media/*",
            "x-media/*"
          ]
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::avanca-files-108327566923-us-east-2/media/*",
        "arn:aws:s3:::avanca-files-108327566923-us-east-2/instagram-publisher/*",
        "arn:aws:s3:::avanca-files-108327566923-us-east-2/tiktok-media/*",
        "arn:aws:s3:::avanca-files-108327566923-us-east-2/x-media/*"
      ]
    }
  ]
}
